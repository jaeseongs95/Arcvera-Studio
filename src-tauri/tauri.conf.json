{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcvera-Studio",
  "version": "2.0.1",
  "identifier": "io.agentgrid.desktop",
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcvera-Studio",
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE",
      "../LICENSE-MIT-LEGACY": "LICENSE-MIT-LEGACY",
      "../SOURCE.md": "SOURCE.md",
      "installer/RUNTIME.md": "RUNTIME.md",
      "installer/RUNTIME.ko.md": "RUNTIME.ko.md"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Local coding agent terminal workspace",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "publisher": "Arcvera-Studio",
    "homepage": "https://github.com/jaeseongs95/Arcvera-Studio"
  }
}
